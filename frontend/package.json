{
  "name": "quillite-markdown-wails-frontend",
  "private": true,
  "version": "2.7.3",
  "type": "module",
  "scripts": {
    "prepare:mermaid": "node scripts/prepare-mermaid.mjs",
    "prepare:spellcheck": "node scripts/prepare-spellcheck.mjs",
    "prepare:vendor": "npm run prepare:mermaid && npm run prepare:spellcheck",
    "dev": "npm run prepare:mermaid && npm run prepare:spellcheck && vite",
    "build": "npm run prepare:mermaid && npm run prepare:spellcheck && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.11.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@lezer/highlight": "^1.2.1",
    "codemirror": "^6.0.2",
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
    "dompurify": "^3.4.15",
    "echarts": "^6.1.0",
    "echarts-wordcloud": "^2.1.0",
    "highlight.js": "^11.11.1",
    "html-to-image": "^1.11.13",
    "katex": "^0.16.47",
    "marked": "^15.0.12",
    "mermaid": "^11.17.2",
    "nspell": "^2.1.5",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "vite": "^7.3.6"
  },
  "overrides": {
    "echarts-wordcloud": {
      "echarts": "$echarts"
    }
  }
}
