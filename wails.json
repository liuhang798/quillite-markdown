{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "quillite-markdown",
  "outputfilename": "QuilliteMarkdown",
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "author": {
    "name": "柳航",
    "email": "liuhang798@users.noreply.github.com"
  },
  "info": {
    "companyName": "Quillite Open Source",
    "productName": "轻阅 Markdown",
    "productVersion": "2.7.1",
    "copyright": "Copyright © 2026 柳航",
    "comments": "Quillite Markdown is a lightweight local-first Markdown reader and editor built with Go and Wails.",
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown Document",
        "description": "Markdown 文档",
        "iconName": "mdFileIcon",
        "role": "Editor"
      },
      {
        "ext": "markdown",
        "name": "Markdown Document",
        "description": "Markdown 文档",
        "iconName": "mdFileIcon",
        "role": "Editor"
      },
      {
        "ext": "mdown",
        "name": "Markdown Document",
        "description": "Markdown 文档",
        "iconName": "mdFileIcon",
        "role": "Editor"
      },
      {
        "ext": "mkd",
        "name": "Markdown Document",
        "description": "Markdown 文档",
        "iconName": "mdFileIcon",
        "role": "Editor"
      },
      {
        "ext": "txt",
        "name": "Text Document",
        "description": "文本文件",
        "iconName": "mdFileIcon",
        "role": "Editor"
      }
    ]
  }
}
